# Copy this file to .env and adjust if needed. Every default below is offline-safe.

# --- API ---
PORT=4000
DATABASE_URL="file:./dev.db"
# CHANGE THIS before any real deployment — it signs every login token.
JWT_SECRET="demo-secret-change-me"
# One origin, a comma-separated list, or "*". Ignored when the API serves the
# frontend itself (the Docker deploy does this — same origin, no CORS).
CORS_ORIGIN="http://localhost:5173"

# --- Deployment (see DEPLOYMENT.md) ---
NODE_ENV="development"
# Directory of the built frontend for the API to serve. The Docker image sets
# this; leave blank for local dev (Vite serves the frontend separately).
WEB_DIST_DIR=""
# Mounts /api/demo/* (wipe-and-reseed, fake bookings). Defaults to true in dev,
# false in production. NEVER set true on a real deployment.
DEMO_MODE=""
# Set true ONCE against a brand-new empty database to load pilot data.
SEED_ON_START="false"
# Docker Compose only: host port to publish the app on.
APP_PORT=4000

# ML service
ML_SERVICE_URL="http://localhost:8000"

# Weather (Open-Meteo needs no key; set to "offline" to force the seasonal fallback)
WEATHER_MODE="live"

# Voice provider: mock (default, no key, uses Web Speech API in the browser) | sarvam
VOICE_PROVIDER="mock"
SARVAM_API_KEY=""

# Cron interval for recompute job, in minutes
CRON_INTERVAL_MIN=2

# Real-phone SMS OTP login (optional). Leave unset to keep the mock OTP flow
# (always 123456, no SMS, fully offline). To enable real SMS:
#   1. Create a free Firebase project at https://console.firebase.google.com
#   2. Authentication -> Sign-in method -> enable "Phone"
#   3. Project settings -> Service accounts -> Generate new private key,
#      save the JSON file somewhere OUTSIDE version control, and point this at it:
FIREBASE_SERVICE_ACCOUNT_PATH=""

# --- Web ---
VITE_API_URL="http://localhost:4000"

# Firebase web config for real-phone login (optional, pairs with
# FIREBASE_SERVICE_ACCOUNT_PATH above — both must be set to enable real SMS).
# Project settings -> General -> Your apps -> Web app -> SDK setup and
# configuration. These are public client keys, safe to commit/expose.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# --- ML service ---
ML_PORT=8000
